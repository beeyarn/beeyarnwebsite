    <script>
        function fmt(n) { return parseFloat(n).toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 3 }); }

        fetch('https://api.beeyarn.com/api/settings')
            .then(function(res) { return res.json(); })
            .then(function(json) {
                var d = json.data;
                var ps = d.reward_type.points_system;

                // Max per day
                document.getElementById('max-per-day').textContent = 'Max ' + fmt(ps.global_settings.max_points_per_day) + ' pts/day';

                // Activity points
                document.getElementById('pts-login').textContent         = fmt(ps.daily_login.daily_limit) + ' pts';
                document.getElementById('lim-login').textContent         = fmt(ps.daily_login.daily_limit) + ' pts/day';
                document.getElementById('pts-post').textContent          = fmt(ps.post_creation.points) + ' pts';
                document.getElementById('lim-post').textContent          = fmt(ps.post_creation.daily_limit) + ' pts/day';
                document.getElementById('pts-like-giver').textContent    = fmt(ps.post_like.giver_points) + ' pts';
                document.getElementById('lim-like-giver').textContent    = fmt(ps.post_like.giver_daily_limit) + ' pts/day';
                document.getElementById('pts-like-receiver').textContent = fmt(ps.post_like.receiver_points) + ' pts per like';
                document.getElementById('pts-comment').textContent       = fmt(ps.comment.commenter_points) + ' pts';
                document.getElementById('lim-comment').textContent       = fmt(ps.comment.commenter_daily_limit) + ' pts/day';
                document.getElementById('pts-comment-owner').textContent = fmt(ps.comment.post_owner_points) + ' pts per comment';
                document.getElementById('pts-eng-likes').textContent     = fmt(ps.post_engagement_received.points_per_10_likes) + ' pts';
                document.getElementById('pts-eng-comments').textContent  = fmt(ps.post_engagement_received.points_per_5_comments) + ' pts';
                document.getElementById('pts-share').textContent         = fmt(ps.post_share.points_per_share) + ' pts per share';
                document.getElementById('lim-share').textContent         = fmt(ps.post_share.daily_limit) + ' pts/day';
                document.getElementById('pts-connection').textContent    = fmt(ps.real_connections.new_connection_points) + ' pts';
                document.getElementById('lim-connection').textContent    = fmt(ps.real_connections.daily_limit) + ' pts/day';

                // Live
                document.getElementById('pts-live-host').textContent      = fmt(ps.live_stream.host_points) + ' pts';
                document.getElementById('lim-live-day').textContent       = 'Max ' + ps.live_stream.max_lives_per_day + ' lives/day';
                document.getElementById('pts-live-viewer').textContent    = fmt(ps.live_stream.viewer_points) + ' pts';
                document.getElementById('lim-live-viewer').textContent    = fmt(ps.live_stream.viewer_daily_limit) + ' pts/day';
                document.getElementById('pts-live-10min').textContent     = fmt(ps.live_stream.points_for_10_minutes) + ' pts';
                document.getElementById('pts-live-100viewers').textContent = fmt(ps.live_stream.points_for_100_viewers) + ' pts';
                document.getElementById('min-watch-sec').textContent      = ps.live_stream.min_watch_seconds_for_points;

                // Referrals
                document.getElementById('pts-ref-signup').textContent    = fmt(ps.referral.signup_points) + ' pts';
                document.getElementById('pts-ref-firstpost').textContent = fmt(ps.referral.first_post_points) + ' pts';
                document.getElementById('pts-ref-7days').textContent     = fmt(ps.referral.active_7_days_points) + ' pts';

                // Milestones
                document.getElementById('ms-profile').textContent        = fmt(ps.milestones.profile_completed) + ' pts';
                document.getElementById('ms-email').textContent          = fmt(ps.milestones.verified_email) + ' pts';
                document.getElementById('ms-firstpost').textContent      = fmt(ps.milestones.first_post) + ' pts';
                document.getElementById('ms-10posts').textContent        = fmt(ps.milestones.milestone_10_posts_created) + ' pts';
                document.getElementById('ms-100followers').textContent   = fmt(ps.milestones.first_100_followers) + ' pts';
                document.getElementById('ms-likes-interval').textContent = ps.milestones.likes_milestone_interval;
                document.getElementById('ms-likes-pts').textContent      = fmt(ps.milestones.likes_milestone_points) + ' pts';
                document.getElementById('ms-views-interval').textContent = ps.milestones.views_milestone_interval;
                document.getElementById('ms-views-pts').textContent      = fmt(ps.milestones.views_milestone_points) + ' pts';

                // Payout requirements
                document.getElementById('min-followers').textContent = (d.min_followers_for_payout || 10000).toLocaleString();
                document.getElementById('sub-months').textContent    = d.subscription_months_required_for_payout || 3;
                document.getElementById('min-points').textContent    = (d.min_yarn_points_for_payout || 10000).toLocaleString();

                // Currency rates
                var currencies = d.currency.currencies;
                var tbody = document.getElementById('currency-tbody');
                tbody.innerHTML = '';
                Object.keys(currencies).forEach(function(code) {
                    var c = currencies[code];
                    var row = document.createElement('tr');
                    row.innerHTML =
                        '<td>' + c.country + '</td>' +
                        '<td>' + c.name + ' (' + c.currency_code + ')</td>' +
                        '<td class="pts">' + c.symbol + '' + c.conversion_rate_per_point + '</td>';
                    tbody.appendChild(row);
                });
            })
            .catch(function() {
                // Fallback values already in HTML — silently keep them
            });
    </script>
</body>
</html>
