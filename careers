<!DOCTYPE html>
<html lang="en">
<head>
    <script src="https://web.cmp.usercentrics.eu/modules/autoblocker.js"></script>
    <script id="usercentrics-cmp" src="https://web.cmp.usercentrics.eu/ui/loader.js" data-settings-id="roz7umFKXvgacw" async></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="BeeYarn Careers" content="" />
    <meta name="author" content="" />
    <title>BeeYarn - Be Seen. Be Heard</title>
    <link rel="icon" type="image/x-icon" href="assets/favicon.jpg" />
    <!-- Bootstrap icons-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Google fonts-->
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,600;1,600&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Mulish:ital,wght@0,300;0,500;0,600;0,700;1,300;1,500;1,600;1,700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Kanit:ital,wght@0,400;1,400&amp;display=swap" rel="stylesheet" />
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="css/styles.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            color: #1C5B31;
        }
        .navbar-light .navbar-brand {
            color: #1C5B31;
        }
        .navbar-light .navbar-nav .nav-link {
            color: #1C5B31;
        }
        .btn-primary {
            background-color: #1C5B31;
            border-color: #1C5B31;
        }
        .btn-primary:hover {
            background-color: #145022;
            border-color: #145022;
        }
        .icon-feature {
            color: #1C5B31;
        }
        .form-control, .form-floating label {
            color: #1C5B31;
            border-color: #1C5B31;
        }
        .form-control:focus {
            border-color: #1C5B31;
            box-shadow: 0 0 0 0.2rem rgba(28, 91, 49, 0.25);
        }
        .form-floating .form-control:focus ~ label {
            color: #1C5B31;
        }
        .overlay {
            position: fixed;
            inset-block-start: 0;
            inset-inline-start: 0;
            inline-size: 100%;
            block-size: 100%;
            background: rgba(0, 0, 0, 0.8);
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 2rem;
            z-index: 1000;
        }
        /* Flexbox layout with reversed order */
        #features .row {
            display: flex;
            align-items: center;
        }
        #open-roles {
            flex: 1;
            margin-right: 30px; /* Space between the video and open roles */
        }
        .features-device-mockup {
            flex: 1;
            display: flex;
            justify-content: center;
        }
        /* Make video and open roles stack on smaller screens */
        @media (max-width: 768px) {
            #features .row {
                flex-direction: column; /* Stack the items */
            }
            #open-roles {
                margin-right: 0; /* Reset the right margin */
                margin-top: 20px; /* Space between the video and open roles */
            }
        }

        /* Open Roles Section Styling */
        #open-roles h2 {
            font-size: 2rem;
            color: #1C5B31;
        }
        #open-roles p {
            font-size: 1.2rem;
            color: #4A4A4A;
        }
        #open-roles a {
            font-weight: bold;
            color: #1C5B31;
        }
    </style>
</head>
<body id="page-top">
    <div id="shared-header"></div>

      
      
    <section id="features">
        <div class="container px-5">
            <div class="row gx-5">
                <!-- Video Section -->
                <div class="features-device-mockup">
                    <div class="device-wrapper">
                        <div class="device" data-device="iPhoneX" data-orientation="portrait" data-color="black">
                            <div class="screen bg-black">
                            <video loading="lazy" muted="muted" autoplay="" loop="" style="max-width: 100%; height: 100%" controls><source src="assets/img/demo-screen.mp4" type="video/mp4" /></video>

                            </div>
                        </div>
                    </div>
                </div>
                
                
                
                

                <!-- Open Roles Section -->
                <div id="open-roles">
                    <h2>Open Roles</h2>
                    <p>Currently, we don't have any open roles. However, we are always looking for passionate individuals to join our team. Stay tuned for future openings!</p>
                    <p>If you'd like to be considered for future opportunities, feel free to contact us at <a href="mailto:careers@beeyarn.com">careers@beeyarn.com</a>.</p>
                </div>
            </div>
        </div>
    </section>

    <div id="shared-footer"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/scripts.js"></script>
    <script src="js/shared-shell.js"></script>
    <script src="https://cdn.startbootstrap.com/sb-forms-latest.js"></script>
</body>
</html>
